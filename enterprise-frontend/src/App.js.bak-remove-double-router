import React from 'react';
import {
  BrowserRouter,
  Routes,
  Route,
  Navigate,
  Link
} from 'react-router-dom';

import TenantClosedLoopControlHubPage from './pages/TenantClosedLoopControlHubPage';

class AppErrorBoundary extends React.Component {
  constructor(props) {
    super(props);

    this.state = {
      hasError: false,
      error: null
    };
  }

  static getDerivedStateFromError(error) {
    return {
      hasError: true,
      error
    };
  }

  componentDidCatch(error, info) {
    console.error('[RAFTOP FRONTEND ERROR]', error, info);
  }

  render() {
    if (this.state.hasError) {
      return (
        <div style={{ minHeight: '100vh', background: '#f8fafc', padding: 32 }}>
          <div
            style={{
              maxWidth: 900,
              margin: '0 auto',
              background: '#ffffff',
              border: '1px solid #fecaca',
              borderRadius: 24,
              padding: 32
            }}
          >
            <h1 style={{ color: '#991b1b' }}>
              Frontend Runtime Error
            </h1>

            <p style={{ color: '#475569' }}>
              Η λευκή σελίδα αντικαταστάθηκε με error boundary. Το πρόβλημα είναι runtime ή import error.
            </p>

            <pre
              style={{
                marginTop: 20,
                background: '#111827',
                color: '#f9fafb',
                padding: 16,
                borderRadius: 12,
                overflow: 'auto'
              }}
            >
              {String(this.state.error?.message || this.state.error)}
            </pre>
          </div>
        </div>
      );
    }

    return this.props.children;
  }
}

function TenantPageNotFound() {
  return (
    <div style={{ minHeight: '100vh', background: '#f8fafc', padding: 32 }}>
      <div
        style={{
          maxWidth: 900,
          margin: '0 auto',
          background: '#ffffff',
          border: '1px solid #e2e8f0',
          borderRadius: 24,
          padding: 32
        }}
      >
        <div
          style={{
            fontSize: 12,
            fontWeight: 800,
            letterSpacing: '0.18em',
            color: '#2563eb',
            textTransform: 'uppercase'
          }}
        >
          RAFTOP CPAP CARE Pro / ATLAS
        </div>

        <h1 style={{ marginTop: 12, fontSize: 32, color: '#0f172a' }}>
          Tenant Page Not Found
        </h1>

        <p style={{ color: '#475569', fontSize: 15 }}>
          The tenant route you opened is not mapped yet in App.js.
        </p>

        <Link
          to="/tenant/closed-loop/control-hub"
          style={{
            display: 'inline-block',
            marginTop: 20,
            background: '#0f172a',
            color: '#ffffff',
            textDecoration: 'none',
            padding: '12px 18px',
            borderRadius: 14,
            fontWeight: 700
          }}
        >
          Open Closed Loop Control Hub
        </Link>
      </div>
    </div>
  );
}

function RootRedirect() {
  return <Navigate to="/tenant/closed-loop/control-hub" replace />;
}

export default function App() {
  return (
    <AppErrorBoundary>
      <BrowserRouter>
        <Routes>
          <Route path="/" element={<RootRedirect />} />

          <Route
            path="/tenant/closed-loop/control-hub"
            element={<TenantClosedLoopControlHubPage />}
          />

          <Route path="/tenant/*" element={<TenantPageNotFound />} />
          <Route path="*" element={<TenantPageNotFound />} />
        </Routes>
      </BrowserRouter>
    </AppErrorBoundary>
  );
}