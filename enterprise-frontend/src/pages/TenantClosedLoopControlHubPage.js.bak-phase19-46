export default function TenantClosedLoopControlHubPage() {
  const [signalId, setSignalId] = useState('AT-001');
  const [taskId, setTaskId] = useState('');
  const [verificationId, setVerificationId] = useState('');
  const [sourceActionId, setSourceActionId] = useState('');

  const [loadingHealth, setLoadingHealth] = useState(false);
  const [loadingSummary, setLoadingSummary] = useState(false);

  const [health, setHealth] = useState({
    verification: null,
    remediation: null,
    resolution: null,
    control: null
  });

  const [errors, setErrors] = useState({
    verification: '',
    remediation: '',
    resolution: '',
    control: ''
  });

  const [summary, setSummary] = useState(null);
  const [summaryError, setSummaryError] = useState('');

  async function checkHealth() {
    setLoadingHealth(true);
    setErrors({
      verification: '',
      remediation: '',
      resolution: '',
      control: ''
    });

    const nextHealth = {
      verification: null,
      remediation: null,
      resolution: null,
      control: null
    };

    const nextErrors = {
      verification: '',
      remediation: '',
      resolution: '',
      control: ''
    };

    try {
      nextHealth.verification = await apiRequest('/api/tenant/closed-loop-verification/health', {
        errorLabel: 'Verification health failed'
      });
    } catch (error) {
      nextErrors.verification = error?.message || 'Verification health failed';
    }

    try {
      nextHealth.remediation = await apiRequest('/api/tenant/closed-loop-remediation/health', {
        errorLabel: 'Remediation health failed'
      });
    } catch (error) {
      nextErrors.remediation = error?.message || 'Remediation health failed';
    }

    try {
      nextHealth.resolution = await apiRequest('/api/tenant/closed-loop-resolution/health', {
        errorLabel: 'Resolution health failed'
      });
    } catch (error) {
      nextErrors.resolution = error?.message || 'Resolution health failed';
    }

    try {
      nextHealth.control = await apiRequest('/api/tenant/closed-loop-control/health', {
        errorLabel: 'Control health failed'
      });
    } catch (error) {
      nextErrors.control = error?.message || 'Control health failed';
    }

    setHealth(nextHealth);
    setErrors(nextErrors);
    setLoadingHealth(false);
  }

  async function loadSummary() {
    setLoadingSummary(true);
    setSummaryError('');

    try {
      const payload = await apiRequest('/api/tenant/closed-loop-control/summary', {
        errorLabel: 'Closed loop control summary failed'
      });

      setSummary(payload);
    } catch (error) {
      setSummaryError(error?.message || 'Closed loop control summary failed');
    } finally {
      setLoadingSummary(false);
    }
  }

  function openVerification() {
    openTenantRoute(
      buildQueryPath('/tenant/closed-loop-verification', {
        signalId,
        taskId,
        sourceActionId
      })
    );
  }

  function openRemediation() {
    openTenantRoute(
      buildQueryPath('/tenant/closed-loop-remediation', {
        signalId,
        taskId,
        sourceActionId
      })
    );
  }

  function openResolution() {
    openTenantRoute(
      buildQueryPath('/tenant/closed-loop-resolution', {
        signalId,
        taskId,
        verificationId
      })
    );
  }

  function openAtlas() {
    openTenantRoute('/tenant/atlas/action-center');
  }

  const allHealthy =
    health.verification?.ok === true &&
    health.remediation?.ok === true &&
    health.resolution?.ok === true &&
    health.control?.ok === true;

  const metrics = summary?.metrics || {};
  const realStatus = summary?.systemStatus || 'unknown';

  return (
    <div className="control-hub-page">
      <style>{pageStyles}</style>

      <section className="hero-card">
        <div>
          <div className="eyebrow">ATLAS CLOSED LOOP CONTROL</div>
          <h1>Closed Loop Control Hub</h1>
          <p>
            Phase 19.44: το hub δεν δείχνει πλέον μόνο health checks. Τραβάει πραγματικά operational metrics
            από το backend και αποδεικνύει αν το closed loop κλείνει επιχειρησιακά.
          </p>
        </div>

        <div className="hero-metrics">
          <KpiCard
            label="Endpoint chain"
            value={allHealthy ? 'Healthy' : 'Check'}
            tone={allHealthy ? 'success' : 'warning'}
            subtext="Verification + Remediation + Resolution + Control"
          />
          <KpiCard
            label="Operational status"
            value={statusLabel(realStatus)}
            tone={statusTone(realStatus)}
            subtext="From real summary"
          />
          <KpiCard
            label="Problem records"
            value={metrics.problemVerifications || 0}
            tone={numberValue(metrics.problemVerifications) > 0 ? 'danger' : 'success'}
          />
          <KpiCard
            label="Completion rate"
            value={`${metrics.completionRate || 0}%`}
            tone={numberValue(metrics.completionRate) >= 80 ? 'success' : 'warning'}
          />
        </div>
      </section>

      <section className="toolbar-card">
        <div className="input-group">
          <label>Signal ID</label>
          <input
            value={signalId}
            onChange={(event) => setSignalId(event.target.value)}
            placeholder="AT-001"
          />
        </div>

        <div className="input-group">
          <label>Task ID</label>
          <input
            value={taskId}
            onChange={(event) => setTaskId(event.target.value)}
            placeholder="atlas-task-..."
          />
        </div>

        <div className="input-group">
          <label>Verification ID</label>
          <input
            value={verificationId}
            onChange={(event) => setVerificationId(event.target.value)}
            placeholder="clv-..."
          />
        </div>

        <div className="input-group">
          <label>Source Action ID</label>
          <input
            value={sourceActionId}
            onChange={(event) => setSourceActionId(event.target.value)}
            placeholder="ATT-001"
          />
        </div>

        <button
          type="button"
          className="primary-btn"
          disabled={loadingHealth}
          onClick={checkHealth}
        >
          {loadingHealth ? 'Checking...' : 'Check Backend Chain'}
        </button>

        <button
          type="button"
          className="success-btn"
          disabled={loadingSummary}
          onClick={loadSummary}
        >
          {loadingSummary ? 'Loading...' : 'Load Real Metrics'}
        </button>
      </section>

      <OperationalSummary
        summary={summary}
        loading={loadingSummary}
        error={summaryError}
        onRefresh={loadSummary}
      />

      <section className="flow-card">
        <div className="section-header">
          <div>
            <div className="eyebrow">OPERATIONAL FLOW</div>
            <h2>End-to-end closed loop</h2>
          </div>

          <button type="button" className="ghost-btn" onClick={openAtlas}>
            Back to ATLAS
          </button>
        </div>

        <div className="flow-grid">
          <FlowStep
            number="1"
            title="Run Verification"
            status={health.verification?.ok ? 'OK' : 'Pending'}
            description="Ελέγχει αν task, signal, payload και writeback είναι συνεπή."
            actionLabel="Open Verification"
            onAction={openVerification}
          />

          <FlowStep
            number="2"
            title="Create Remediation"
            status={health.remediation?.ok ? 'OK' : 'Pending'}
            description="Μετατρέπει failed/warning verification σε πραγματικό remediation task."
            actionLabel="Open Remediation"
            onAction={openRemediation}
          />

          <FlowStep
            number="3"
            title="Sync Resolution"
            status={health.resolution?.ok ? 'OK' : 'Pending'}
            description="Όταν το remediation task γίνει done/resolved, γράφει resolved πίσω στο audit."
            actionLabel="Open Resolution"
            onAction={openResolution}
          />
        </div>
      </section>

      <section className="health-grid">
        <HealthPanel
          title="Verification API"
          subtitle="/api/tenant/closed-loop-verification/health"
          data={health.verification}
          error={errors.verification}
        />

        <HealthPanel
          title="Remediation API"
          subtitle="/api/tenant/closed-loop-remediation/health"
          data={health.remediation}
          error={errors.remediation}
        />

