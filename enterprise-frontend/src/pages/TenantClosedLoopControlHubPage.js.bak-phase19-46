import React, { useState } from 'react';

const API_BASE = (process.env.REACT_APP_API_URL || '').replace(/\/+$/, '');

function buildUrl(path) {
  return API_BASE ? `${API_BASE}${path}` : path;
}

function readToken() {
  try {
    return (
      localStorage.getItem('raftop_auth_token') ||
      localStorage.getItem('token') ||
      ''
    );
  } catch (_error) {
    return '';
  }
}

async function readJsonSafely(response) {
  const text = await response.text();

  if (!text) return {};

  try {
    return JSON.parse(text);
  } catch (_error) {
    return {};
  }
}

async function apiRequest(path, options = {}) {
  const token = readToken();

  const response = await fetch(buildUrl(path), {
    method: options.method || 'GET',
    headers: {
      Accept: 'application/json',
      'Content-Type': 'application/json',
      ...(token ? { Authorization: `Bearer ${token}` } : {}),
      ...(options.headers || {})
    },
    credentials: 'include',
    body: options.body ? JSON.stringify(options.body) : undefined
  });

  const payload = await readJsonSafely(response);

  if (!response.ok || payload?.ok === false) {
    throw new Error(payload?.message || options.errorLabel || 'Closed loop hub request failed');
  }

  return payload?.data ?? payload;
}

function firstValue(...values) {
  for (const value of values) {
    if (value !== undefined && value !== null && value !== '') return value;
  }

  return null;
}

function parseJsonArray(value) {
  if (!value) return [];
  if (Array.isArray(value)) return value;

  if (typeof value === 'object') {
    if (Array.isArray(value.items)) return value.items;
    if (Array.isArray(value.rows)) return value.rows;
    if (Array.isArray(value.problems)) return value.problems;
    if (Array.isArray(value.remediationTasks)) return value.remediationTasks;
    return [];
  }

  if (typeof value === 'string') {
    try {
      const parsed = JSON.parse(value);
      if (Array.isArray(parsed)) return parsed;
      if (parsed && Array.isArray(parsed.items)) return parsed.items;
      if (parsed && Array.isArray(parsed.rows)) return parsed.rows;
      return [];
    } catch (_error) {
      return [];
    }
  }

  return [];
}

function numberValue(value) {
  const number = Number(value);
  return Number.isFinite(number) ? number : 0;
}

function statusTone(value = '') {
  const status = String(value || '').toLowerCase();

  if (
    [
      'ok',
      'success',
      'synced',
      'resolved',
      'healthy',
      'no_problems',
      'passed',
      'done',
      'completed',
      'complete',
      'closed',
      'fixed',
      'true'
    ].includes(status)
  ) {
    return 'success';
  }

  if (
    [
      'warning',
      'open',
      'pending',
      'partial',
      'needs_task',
      'task_created',
      'task_exists',
      'not_started'
    ].includes(status)
  ) {
    return 'warning';
  }

  if (
    [
      'failed',
      'error',
      'critical',
      'missing',
      'missing_task',
      'false'
    ].includes(status)
  ) {
    return 'danger';
  }

  return 'neutral';
}

function statusLabel(value = '') {
  const status = String(value || '').toLowerCase();

  if (status === 'healthy') return 'Healthy';
  if (status === 'critical') return 'Critical';
  if (status === 'warning') return 'Warning';
  if (status === 'no_problems') return 'No Problems';
  if (status === 'passed') return 'Passed';
  if (status === 'failed') return 'Failed';
  if (status === 'task_created') return 'Task Created';
  if (status === 'task_exists') return 'Task Exists';
  if (status === 'not_started') return 'Not Started';
  if (status === 'resolved') return 'Resolved';
  if (status === 'open') return 'Open';
  if (status === 'missing_task') return 'Missing Task';
  if (status === 'done') return 'Done';
  if (status === 'completed') return 'Completed';
  if (status === 'closed') return 'Closed';

  return value || 'Unknown';
}

function badgeClass(tone = '') {
  if (tone === 'success') return 'success';
  if (tone === 'warning') return 'warning';
  if (tone === 'danger') return 'danger';
  return 'neutral';
}

function formatDateTime(value) {
  if (!value) return '—';

  const date = new Date(value);

  if (Number.isNaN(date.getTime())) return value;

  return new Intl.DateTimeFormat('el-GR', {
    dateStyle: 'medium',
    timeStyle: 'short'
  }).format(date);
}

function openTenantRoute(path) {
  window.location.href = path;
}

function buildQueryPath(basePath, filters = {}) {
  const query = new URLSearchParams();

  if (filters.signalId) query.set('signalId', filters.signalId);
  if (filters.taskId) query.set('taskId', filters.taskId);
  if (filters.verificationId) query.set('verificationId', filters.verificationId);
  if (filters.sourceActionId) query.set('sourceActionId', filters.sourceActionId);
  if (filters.verdict) query.set('verdict', filters.verdict);
  if (filters.resolutionStatus) query.set('resolutionStatus', filters.resolutionStatus);

  const qs = query.toString();

  return qs ? `${basePath}?${qs}` : basePath;
}

function KpiCard({ label, value, tone, subtext }) {
  return (
    <div className={`kpi-card ${badgeClass(tone)}`}>
      <span>{label}</span>
      <strong>{value}</strong>
      {subtext ? <small>{subtext}</small> : null}
    </div>
  );
}

function FlowStep({ number, title, description, status, actionLabel, onAction }) {
  const tone = statusTone(status);

  return (
    <div className={`flow-step ${badgeClass(tone)}`}>
      <div className="step-number">{number}</div>

      <div className="step-body">
        <div className="step-top">
          <h3>{title}</h3>
          <span className={`badge ${badgeClass(tone)}`}>{statusLabel(status || 'Ready')}</span>
        </div>

        <p>{description}</p>

        <button type="button" className="ghost-btn" onClick={onAction}>
          {actionLabel}
        </button>
      </div>
    </div>
  );
}

function HealthPanel({ title, subtitle, data, error }) {
  const ok = data?.ok === true;
  const tone = error ? 'danger' : ok ? 'success' : 'warning';

  return (
    <div className={`health-panel ${badgeClass(tone)}`}>
      <div>
        <h3>{title}</h3>
        <p>{subtitle}</p>
      </div>

      <span className={`badge ${badgeClass(tone)}`}>
        {error ? 'Error' : ok ? 'OK' : 'Unknown'}
      </span>

      {error ? <div className="health-error">{error}</div> : null}

      {data ? (
        <div className="health-details">
          <div>Phase: <strong>{data.phase || '—'}</strong></div>
          <div>Route: <strong>{data.route || '—'}</strong></div>
          <div>Checked: <strong>{formatDateTime(data.timestamp || new Date().toISOString())}</strong></div>
        </div>
      ) : null}
    </div>
  );
}

function GroupedPanel({ title, rows, labelKey }) {
  const safeRows = parseJsonArray(rows);

  return (
    <div className="grouped-panel">
      <div className="section-subtitle">{title}</div>

      {safeRows.length ? (
        <div className="grouped-list">
          {safeRows.map((row, index) => {
            const label = firstValue(row[labelKey], row.status, row.verdict, 'unknown');
            const total = firstValue(row.total, row.count, 0);

            return (
              <div key={`${label}-${index}`} className="grouped-row">
                <span className={`badge ${badgeClass(statusTone(label))}`}>
                  {statusLabel(label)}
                </span>
                <strong>{total}</strong>
              </div>
            );
          })}
        </div>
      ) : (
        <div className="empty-state">No grouped data yet.</div>
      )}
    </div>
  );
}

