}

function RootRedirect() {
  return <Navigate to="/tenant/subscription" replace />;
}

export default function App() {
  return (
    <AppErrorBoundary>
      <SubscriptionStatusBanner />

      <Routes>
        <Route path="/" element={<RootRedirect />} />

        <Route
          path="/tenant/subscription"
          element={<TenantSubscriptionPage />}
        />

        <Route
          path="/tenant/closed-loop/control-hub"
          element={<TenantClosedLoopControlHubPage />}
        />

        <Route
          path="/system/stability"
          element={<SystemStabilityPage />}
        />

        <Route
          path="/system/monitoring"
          element={<SystemMonitoringPage />}
        />

        <Route
          path="/system/alerts"
          element={<SystemAlertsPage />}
        />

        <Route
          path="/system/history"
          element={<SystemMonitoringHistoryPage />}
        />

        <Route
          path="/system/maintenance"
          element={<SystemMaintenancePage />}
        />

        <Route path="/tenant/*" element={<TenantPageNotFound />} />
        <Route path="/system/*" element={<TenantPageNotFound />} />
        <Route path="*" element={<TenantPageNotFound />} />
      </Routes>
    </AppErrorBoundary>
  );
}

