      <Link to="/tenant/subscription" style={redLink}>
        Subscription
      </Link>

      <Link to="/system/stability" style={blueLink}>
        System Stability
      </Link>

      <Link to="/system/monitoring" style={greenLink}>
        System Monitoring
      </Link>

      <Link to="/system/alerts" style={orangeLink}>
