import SystemAlertsPage from './pages/SystemAlertsPage';
import SystemMonitoringHistoryPage from './pages/SystemMonitoringHistoryPage';
import SystemMaintenancePage from './pages/SystemMaintenancePage';

class AppErrorBoundary extends React.Component {
  constructor(props) {
    super(props);

    this.state = {
      hasError: false,
      error: null
    };
  }

  static getDerivedStateFromError(error) {
    return {
      hasError: true,
      error
    };
  }

  componentDidCatch(error, info) {
    console.error('[RAFTOP FRONTEND ERROR]', error, info);
  }

  render() {
    if (this.state.hasError) {
      return (
        <div style={{ minHeight: '100vh', background: '#f8fafc', padding: 32 }}>
          <div
            style={{
              maxWidth: 900,
              margin: '0 auto',
              background: '#ffffff',
              border: '1px solid #fecaca',
              borderRadius: 24,
              padding: 32
            }}
          >
            <h1 style={{ color: '#991b1b' }}>
              Frontend Runtime Error
            </h1>

            <p style={{ color: '#475569' }}>
              Υπάρχει runtime ή import error στο frontend.
            </p>

            <pre
              style={{
                marginTop: 20,
                background: '#111827',
                color: '#f9fafb',
                padding: 16,
                borderRadius: 12,
                overflow: 'auto'
              }}
            >
              {String(this.state.error?.message || this.state.error)}
            </pre>
          </div>
        </div>
      );
    }

    return this.props.children;
  }
}

function TenantPageNotFound() {
  return (
    <div style={{ minHeight: '100vh', background: '#f8fafc', padding: 32 }}>
      <div
        style={{
          maxWidth: 1080,
          margin: '0 auto',
          background: '#ffffff',
          border: '1px solid #e2e8f0',
          borderRadius: 24,
          padding: 32,
          boxShadow: '0 10px 30px rgba(15, 23, 42, 0.06)'
        }}
      >
        <div
          style={{
            fontSize: 12,
            fontWeight: 800,
            letterSpacing: '0.18em',
            color: '#2563eb',
            textTransform: 'uppercase'
          }}
        >
          RAFTOP CPAP CARE Pro / ATLAS
        </div>

        <h1 style={{ marginTop: 12, fontSize: 32, color: '#0f172a' }}>
          Page Not Found
        </h1>

        <p style={{ color: '#475569', fontSize: 15 }}>
          The route you opened is not mapped yet in App.js.
        </p>

