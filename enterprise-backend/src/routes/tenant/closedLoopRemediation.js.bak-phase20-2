      'remediation_created_at',
      'remediation_last_run_at',
      'remediation_note',
      'remediation_payload'
    ],
    endpoints: [
      'GET /api/tenant/closed-loop-remediation/queue',
      'POST /api/tenant/closed-loop-remediation/run'
    ],
    timestamp: new Date().toISOString()
  });
});

router.get('/queue', async (req, res) => {
  try {
    const queue = await buildRemediationQueue(req.query || {});

    return res.json({
      ok: true,
      data: {
        ok: true,
        phase: '19.38-remediation-writeback-to-audit-record',
        generatedAt: new Date().toISOString(),
        total: queue.length,
        needsTask: queue.filter((item) => item.remediationStatus === 'needs_task').length,
        taskExists: queue.filter((item) => item.remediationStatus === 'task_exists').length,
        auditTaskCreated: queue.filter((item) => item.auditRemediationStatus === 'task_created').length,
        auditTaskExists: queue.filter((item) => item.auditRemediationStatus === 'task_exists').length,
        items: queue,
        queue,
        rows: queue,
        debug: {
          route: 'tenant/closedLoopRemediation/queue',
          query: req.query || {}
        }
      }
    });
  } catch (error) {
    return res.status(500).json({
      ok: false,
      message: error.message || 'Closed loop remediation queue failed.',
      phase: '19.38-remediation-writeback-to-audit-record'
    });
  }
});

router.post('/run', async (req, res) => {
  try {
    const queryParams = {
      ...(req.query || {}),
      ...(req.body || {})
    };

    const records = await listProblemRecords(queryParams);
    const results = [];

    for (const record of records) {
      const outcome = await createRemediationTask(record);

      results.push({
        verificationId: record.id,
        verification_id: record.id,
        verdict: record.verdict,
        signalId: getRecordSignalId(record),
        signal_id: getRecordSignalId(record),
        originalTaskId: getRecordTaskId(record),
        original_task_id: getRecordTaskId(record),
        ...outcome
      });
    }

    const created = results.filter((item) => item.created).length;
    const skipped = results.filter((item) => item.skipped).length;
    const writebackUpdated = results.filter((item) => item.verificationRecord).length;

    return res.json({
      ok: true,
      data: {
        ok: true,
        phase: '19.38-remediation-writeback-to-audit-record',
        generatedAt: new Date().toISOString(),
        total: results.length,
        created,
        skipped,
        writebackUpdated,
        writeback_updated: writebackUpdated,
        results,
        items: results,
        rows: results,
        debug: {
          route: 'tenant/closedLoopRemediation/run',
          query: req.query || {},
          body: req.body || {}
        }
      }
    });
  } catch (error) {
    return res.status(500).json({
      ok: false,
      message: error.message || 'Closed loop remediation run failed.',
      phase: '19.38-remediation-writeback-to-audit-record'
    });
  }
});

module.exports = router;