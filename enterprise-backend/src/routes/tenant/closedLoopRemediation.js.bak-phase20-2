function getRecordSignalId(record = {}) {
  const evidence = parseJsonObject(record.evidence);
  const signalSnapshot = parseJsonObject(record.signal_snapshot || record.signalSnapshot);
  const taskSnapshot = parseJsonObject(record.task_snapshot || record.taskSnapshot);

  return firstValue(
    record.signal_id,
    record.signalId,
    evidence.signalId,
    evidence.taskSignalId,
    signalSnapshot.id,
    signalSnapshot.signalId,
    signalSnapshot.signal_id,
    taskSnapshot.linked_signal_id,
    taskSnapshot.linkedSignalId,
    taskSnapshot.signal_id,
    taskSnapshot.signalId,
    taskSnapshot.atlas_signal_id,
    taskSnapshot.atlasSignalId,
    taskSnapshot.case_id
  );
}

function getRecordTaskId(record = {}) {
  const evidence = parseJsonObject(record.evidence);
  const taskSnapshot = parseJsonObject(record.task_snapshot || record.taskSnapshot);

  return firstValue(
    record.task_id,
    record.taskId,
    evidence.taskId,
    evidence.payloadTaskId,
    taskSnapshot.id,
    taskSnapshot.taskId,
    taskSnapshot.task_id
  );
}

function getRecordPatientName(record = {}) {
  const taskSnapshot = parseJsonObject(record.task_snapshot || record.taskSnapshot);
  const signalSnapshot = parseJsonObject(record.signal_snapshot || record.signalSnapshot);

  return firstValue(
    taskSnapshot.patient_name,
    taskSnapshot.patientName,
    signalSnapshot.patient_name,
    signalSnapshot.patientName,
    signalSnapshot.patient_email,
    signalSnapshot.patientEmail,
    'Closed Loop Patient'
  );
}

function getRecordPatientEmail(record = {}) {
  const taskSnapshot = parseJsonObject(record.task_snapshot || record.taskSnapshot);
  const signalSnapshot = parseJsonObject(record.signal_snapshot || record.signalSnapshot);

  return firstValue(
    taskSnapshot.patient_email,
    taskSnapshot.patientEmail,
    signalSnapshot.patient_email,
    signalSnapshot.patientEmail,
    null
  );
}

function getPriorityForVerdict(verdict = '') {
  const value = safeString(verdict).toLowerCase();

  if (value === 'failed') return 'critical';
  if (value === 'warning') return 'warning';

  return 'medium';
}

function isProblemVerdict(verdict = '') {
  const value = safeString(verdict).toLowerCase();
  return value === 'failed' || value === 'warning';
}

function buildProblemDescription(record = {}) {
  const checks = parseJsonArray(record.checks);
  const failedChecks = checks.filter((check) => check.status === 'failed');
  const warningChecks = checks.filter((check) => check.status === 'warning');

  const lines = [
    'Closed Loop Verification remediation task.',
    `Verification ID: ${record.id || '—'}`,
    `Verdict: ${record.verdict || 'unknown'}`,
    `Signal ID: ${getRecordSignalId(record) || '—'}`,
    `Task ID: ${getRecordTaskId(record) || '—'}`,
    `Created at: ${record.created_at || record.createdAt || '—'}`
  ];

  if (failedChecks.length) {
    lines.push('');
    lines.push('Failed checks:');
    failedChecks.forEach((check) => {
      lines.push(`- ${check.label || check.id || 'Check'}: ${check.detail || 'No detail'}`);
    });
  }

  if (warningChecks.length) {
    lines.push('');
    lines.push('Warning checks:');
    warningChecks.forEach((check) => {
      lines.push(`- ${check.label || check.id || 'Check'}: ${check.detail || 'No detail'}`);
    });
  }

  return lines.join('\n');
}

async function findExistingRemediationTask(recordId) {
  await ensureAtlasTasksTable();

  const sourceRef = `clv:${recordId}`;

  const result = await query(
    `
      SELECT *
      FROM atlas_tasks
      WHERE
        source_ref::text = $1::text
        OR source_action_id::text = $1::text
      ORDER BY created_at DESC NULLS LAST
      LIMIT 1
    `,
    [sourceRef]
  );

  return result.rows && result.rows[0] ? normalizeTask(result.rows[0]) : null;
}

async function markVerificationRemediation({
  recordId,
  status,
  task,
  note,
  payload
}) {
  await ensureVerificationAuditTable();

  const taskId = task ? firstValue(task.id, task.taskId, task.task_id) : null;
  const taskCreatedAt = task
    ? firstValue(task.created_at, task.createdAt, new Date().toISOString())
    : null;

  const result = await query(
    `
      UPDATE closed_loop_verifications
      SET
        remediation_status = $2::text,
        remediation_task_id = $3::text,
        remediation_created_at = CASE
          WHEN $3::text IS NOT NULL THEN COALESCE(remediation_created_at, $4::timestamp with time zone, NOW())
          ELSE remediation_created_at
        END,
        remediation_last_run_at = NOW(),
        remediation_note = $5::text,
        remediation_payload = $6::jsonb
      WHERE id::text = $1::text
      RETURNING *
    `,
    [
      recordId,
      status,
      taskId,
      taskCreatedAt,
      note || null,
      JSON.stringify(payload || {})
    ]
  );

  return result.rows && result.rows[0] ? normalizeVerificationRecord(result.rows[0]) : null;
}

async function createRemediationTask(record) {
  await ensureAtlasTasksTable();
  await ensureVerificationAuditTable();

  const verdict = safeString(record.verdict || 'unknown').toLowerCase();

  if (!isProblemVerdict(verdict)) {
    const updatedRecord = await markVerificationRemediation({
      recordId: record.id,
      status: 'not_required',
      task: null,
      note: `No remediation required for verdict ${verdict}.`,
      payload: {
        phase: '19.38-remediation-writeback-to-audit-record',
        reason: 'not_problem_verdict',
        verdict
      }
    });

    return {
      created: false,
      skipped: true,
      reason: 'not_problem_verdict',
      task: null,
      verificationRecord: updatedRecord,
      verification_record: updatedRecord
    };
  }

  const existing = await findExistingRemediationTask(record.id);

  if (existing) {
    const updatedRecord = await markVerificationRemediation({
      recordId: record.id,
      status: 'task_exists',
      task: existing,
      note: 'Remediation task already exists. Duplicate creation skipped.',
      payload: {
        phase: '19.38-remediation-writeback-to-audit-record',
        reason: 'already_exists',
        task_id: existing.id,
        source_ref: existing.source_ref || existing.sourceRef
      }
    });

    return {
      created: false,
      skipped: true,
      reason: 'already_exists',
      task: existing,
      verificationRecord: updatedRecord,
      verification_record: updatedRecord
    };
  }

  const sourceRef = `clv:${record.id}`;
  const taskId = makeTaskId();
  const signalId = getRecordSignalId(record);
  const originalTaskId = getRecordTaskId(record);
  const priority = getPriorityForVerdict(verdict);
  const patientName = getRecordPatientName(record);
  const patientEmail = getRecordPatientEmail(record);

  const title =
    verdict === 'failed'
      ? `CRITICAL: Closed loop failed for ${signalId || originalTaskId || record.id}`
      : `Review closed loop warning for ${signalId || originalTaskId || record.id}`;

  const description = buildProblemDescription(record);

  const metadata = {
    phase: '19.38-remediation-writeback-to-audit-record',
    remediation_type: 'closed_loop_verification',
    verification_id: record.id,
    original_task_id: originalTaskId || null,
    signal_id: signalId || null,
    verdict,
    passed_count: record.passed_count || record.passedCount || 0,
    warning_count: record.warning_count || record.warningCount || 0,
    failed_count: record.failed_count || record.failedCount || 0,
    evidence: parseJsonObject(record.evidence),
    checks: parseJsonArray(record.checks)
  };

  const result = await query(
    `
      INSERT INTO atlas_tasks (
        id,
        tenant_id,
        case_id,
        patient_name,
        patient_email,
        title,
        description,
        owner,
        priority,
        status,
        action_group_name,
        linked_signal_id,
        signal_id,
        atlas_signal_id,
        source_type,
        source,
        module,
        action_type,
        task_type,
        source_action_id,
        source_ref,
        writeback_status,
        metadata,
        created_at,
        updated_at
      )
      VALUES (
        $1::text,
        $2::text,
        $3::text,
        $4::text,
        $5::text,
        $6::text,
        $7::text,
        'Operations Admin',
        $8::text,
        'open',
        'CLOSED_LOOP_REMEDIATION',
        $9::text,
        $9::text,
        $9::text,
        'closed_loop_verification_remediation',
        'closed_loop_verification',
        'closed_loop_remediation',
        'remediate_closed_loop',
        'closed_loop_remediation',
        $10::text,
        $10::text,
        'pending',
        $11::jsonb,
        NOW(),
        NOW()
      )
      RETURNING *
    `,
    [
      taskId,
      safeString(firstValue(record.tenant_id, record.tenantId, '1')),
      signalId || originalTaskId || record.id,
      patientName,
      patientEmail,
      title,
      description,
      priority,
      signalId || null,
      sourceRef,
      JSON.stringify(metadata)
    ]
  );

  const createdTask = result.rows && result.rows[0] ? normalizeTask(result.rows[0]) : null;

  const updatedRecord = await markVerificationRemediation({
    recordId: record.id,
    status: 'task_created',
    task: createdTask,
    note: 'Remediation task created and linked to closed-loop verification audit record.',
    payload: {
      phase: '19.38-remediation-writeback-to-audit-record',
      reason: 'created',
      task_id: createdTask ? createdTask.id : taskId,
      source_ref: sourceRef
    }
  });

  return {
    created: true,
    skipped: false,
    reason: null,
    task: createdTask,
    verificationRecord: updatedRecord,
    verification_record: updatedRecord
  };
}

async function listProblemRecords(queryParams = {}) {
  await ensureVerificationAuditTable();

  const filters = [];
  const params = [];

  const signalId = firstValue(queryParams.signalId, queryParams.signal_id);
  const taskId = firstValue(queryParams.taskId, queryParams.task_id);
  const sourceActionId = firstValue(queryParams.sourceActionId, queryParams.source_action_id);
  const verdict = firstValue(queryParams.verdict);
  const remediationStatus = firstValue(queryParams.remediationStatus, queryParams.remediation_status);

  if (verdict) {
    params.push(safeString(verdict).toLowerCase());
    filters.push(`LOWER(COALESCE(verdict::text, '')) = $${params.length}::text`);
  } else {
    filters.push(`LOWER(COALESCE(verdict::text, '')) IN ('failed', 'warning')`);
  }

  if (signalId) {
    params.push(safeString(signalId));
    filters.push(`signal_id::text = $${params.length}::text`);
  }

  if (taskId) {
    params.push(safeString(taskId));
    filters.push(`task_id::text = $${params.length}::text`);
  }

  if (sourceActionId) {
    params.push(safeString(sourceActionId));
    filters.push(`source_action_id::text = $${params.length}::text`);
  }

  if (remediationStatus) {
    params.push(safeString(remediationStatus).toLowerCase());
    filters.push(`LOWER(COALESCE(remediation_status::text, 'not_started')) = $${params.length}::text`);
  }

  const limitValue = Number.parseInt(firstValue(queryParams.limit, 25), 10);
  const safeLimit = Number.isFinite(limitValue) && limitValue > 0 && limitValue <= 100 ? limitValue : 25;

  const whereSql = filters.length ? `WHERE ${filters.join(' AND ')}` : '';

  const result = await query(
    `
      SELECT *
      FROM closed_loop_verifications
      ${whereSql}
      ORDER BY
        CASE
          WHEN verdict = 'failed' THEN 0
          WHEN verdict = 'warning' THEN 1
          ELSE 2
        END ASC,
        created_at DESC NULLS LAST
      LIMIT ${safeLimit}
    `,
    params
  );

  return (result.rows || []).map(normalizeVerificationRecord);
}

async function buildRemediationQueue(queryParams = {}) {
  const records = await listProblemRecords(queryParams);
  const queue = [];

  for (const record of records) {
    const existingTask = await findExistingRemediationTask(record.id);

    let status = existingTask ? 'task_exists' : 'needs_task';

    if (existingTask && record.remediation_status === 'task_created') {
      status = 'task_exists';
    }

    if (!existingTask && record.remediation_status === 'task_created') {
      status = 'needs_task';
    }

    queue.push({
      record,
      verification: record,
      remediationStatus: status,
      remediation_status: status,
      auditRemediationStatus: record.remediation_status || 'not_started',
      audit_remediation_status: record.remediation_status || 'not_started',
      remediationTask: existingTask,
      remediation_task: existingTask
    });
  }

  return queue;
}

