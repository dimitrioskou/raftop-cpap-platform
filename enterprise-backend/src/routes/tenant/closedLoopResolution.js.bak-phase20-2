function normalizeTask(row = {}) {
  return {
    ...row,
    id: row.id,
    taskId: row.id,
    task_id: row.id,
    title: row.title || 'Untitled task',
    status: row.status || 'open',
    priority: row.priority || 'medium',
    sourceRef: row.source_ref,
    source_ref: row.source_ref,
    sourceType: row.source_type,
    source_type: row.source_type,
    createdAt: row.created_at,
    created_at: row.created_at,
    updatedAt: row.updated_at,
    updated_at: row.updated_at,
    metadata: parseJsonObject(row.metadata)
  };
}

function normalizeVerificationRecord(row = {}) {
  return {
    ...row,

    id: row.id,

    tenantId: row.tenant_id,
    tenant_id: row.tenant_id,

    taskId: row.task_id,
    task_id: row.task_id,

    signalId: row.signal_id,
    signal_id: row.signal_id,

    sourceActionId: row.source_action_id,
    source_action_id: row.source_action_id,

    verdict: row.verdict || 'unknown',

    checks: parseJsonArray(row.checks),
    evidence: parseJsonObject(row.evidence),
    queryParams: parseJsonObject(row.query_params),
    query_params: parseJsonObject(row.query_params),
    taskSnapshot: parseJsonObject(row.task_snapshot),
    task_snapshot: parseJsonObject(row.task_snapshot),
    signalSnapshot: parseJsonObject(row.signal_snapshot),
    signal_snapshot: parseJsonObject(row.signal_snapshot),

    remediationStatus: row.remediation_status || 'not_started',
    remediation_status: row.remediation_status || 'not_started',

    remediationTaskId: row.remediation_task_id,
    remediation_task_id: row.remediation_task_id,

    remediationCreatedAt: row.remediation_created_at,
    remediation_created_at: row.remediation_created_at,

    remediationLastRunAt: row.remediation_last_run_at,
    remediation_last_run_at: row.remediation_last_run_at,

    remediationNote: row.remediation_note,
    remediation_note: row.remediation_note,

    remediationPayload: parseJsonObject(row.remediation_payload),
    remediation_payload: parseJsonObject(row.remediation_payload),

    remediationResolutionStatus: row.remediation_resolution_status || 'open',
    remediation_resolution_status: row.remediation_resolution_status || 'open',

    remediationResolvedAt: row.remediation_resolved_at,
    remediation_resolved_at: row.remediation_resolved_at,

    remediationResolutionLastSyncAt: row.remediation_resolution_last_sync_at,
    remediation_resolution_last_sync_at: row.remediation_resolution_last_sync_at,

    remediationResolutionNote: row.remediation_resolution_note,
    remediation_resolution_note: row.remediation_resolution_note,

    remediationResolutionPayload: parseJsonObject(row.remediation_resolution_payload),
    remediation_resolution_payload: parseJsonObject(row.remediation_resolution_payload),

