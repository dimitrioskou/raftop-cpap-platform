async function getVerificationRecords(queryParams = {}) {
  await ensureTables();

  const filters = [];
  const params = [];

  const verificationId = firstValue(queryParams.verificationId, queryParams.verification_id, queryParams.id);
  const taskId = firstValue(queryParams.taskId, queryParams.task_id);
  const signalId = firstValue(queryParams.signalId, queryParams.signal_id);
  const resolutionStatus = firstValue(
    queryParams.resolutionStatus,
    queryParams.resolution_status,
    queryParams.remediationResolutionStatus,
    queryParams.remediation_resolution_status
  );

  filters.push(`LOWER(COALESCE(verdict::text, '')) IN ('failed', 'warning')`);

  if (verificationId) {
    params.push(safeString(verificationId));
    filters.push(`id::text = $${params.length}::text`);
  }

  if (taskId) {
    params.push(safeString(taskId));
    filters.push(`
      (
        task_id::text = $${params.length}::text
        OR remediation_task_id::text = $${params.length}::text
      )
    `);
  }

  if (signalId) {
    params.push(safeString(signalId));
    filters.push(`signal_id::text = $${params.length}::text`);
  }

  if (resolutionStatus) {
    params.push(normalizeResolutionStatus(resolutionStatus));
    filters.push(`LOWER(COALESCE(remediation_resolution_status::text, 'open')) = $${params.length}::text`);
  }

  const limitRaw = Number.parseInt(firstValue(queryParams.limit, 50), 10);
  const limit = Number.isFinite(limitRaw) && limitRaw > 0 && limitRaw <= 250 ? limitRaw : 50;

  const whereSql = filters.length ? `WHERE ${filters.join(' AND ')}` : '';

  const result = await query(
    `
      SELECT *
      FROM closed_loop_verifications
      ${whereSql}
      ORDER BY
        CASE
          WHEN COALESCE(remediation_resolution_status, 'open') = 'resolved' THEN 2
          WHEN COALESCE(remediation_status, 'not_started') IN ('task_created', 'task_exists') THEN 0
          ELSE 1
        END ASC,
        created_at DESC NULLS LAST
      LIMIT ${limit}
    `,
    params
  );

  return (result.rows || []).map(normalizeVerificationRecord);
}

async function findRemediationTask(record) {
  await ensureTables();

  const remediationTaskId = firstValue(record.remediation_task_id, record.remediationTaskId);
  const sourceRef = `clv:${record.id}`;

  const params = [];
  const filters = [];

  if (remediationTaskId) {
    params.push(safeString(remediationTaskId));
    filters.push(`id::text = $${params.length}::text`);
  }

  params.push(sourceRef);
  filters.push(`
    (
      source_ref::text = $${params.length}::text
      OR source_action_id::text = $${params.length}::text
    )
  `);

  const result = await query(
    `
      SELECT *
      FROM atlas_tasks
      WHERE ${filters.join(' OR ')}
      ORDER BY updated_at DESC NULLS LAST, created_at DESC NULLS LAST
      LIMIT 1
    `,
    params
  );

  return result.rows && result.rows[0] ? normalizeTask(result.rows[0]) : null;
}

async function updateResolutionFromTask(record, task, options = {}) {
  await ensureTables();

  const nowPayload = {
    phase: '19.40-remediation-resolution-sync',
    mode: options.mode || 'sync',
    verification_id: record.id,
    remediation_task_id: task ? task.id : firstValue(record.remediation_task_id, record.remediationTaskId),
    task_status: task ? task.status : null,
    task_updated_at: task ? firstValue(task.updated_at, task.updatedAt) : null,
    synced_at: new Date().toISOString()
  };

  let nextStatus = 'missing_task';
  let note = 'No remediation task found for this closed-loop verification.';
  let resolvedAt = null;

  if (task) {
    if (isTerminalTaskStatus(task.status)) {
      nextStatus = 'resolved';
      note = `Remediation task is terminal (${task.status}). Closed-loop issue marked resolved.`;
      resolvedAt = firstValue(task.updated_at, task.updatedAt, new Date().toISOString());
    } else {
      nextStatus = 'open';
      note = `Remediation task exists but is still ${task.status || 'open'}.`;
      resolvedAt = null;
    }
  }

  if (options.forceResolved) {
    nextStatus = 'resolved';
    note = options.note || 'Manually marked as resolved from closed-loop resolution endpoint.';
    resolvedAt = new Date().toISOString();
    nowPayload.force_resolved = true;
  }

  const result = await query(
    `
      UPDATE closed_loop_verifications
      SET
        remediation_resolution_status = $2::text,
        remediation_resolved_at = CASE
          WHEN $2::text = 'resolved' THEN COALESCE(remediation_resolved_at, $3::timestamp with time zone, NOW())
          ELSE remediation_resolved_at
        END,
        remediation_resolution_last_sync_at = NOW(),
        remediation_resolution_note = $4::text,
        remediation_resolution_payload = $5::jsonb,
        remediation_task_id = COALESCE(remediation_task_id, $6::text)
      WHERE id::text = $1::text
      RETURNING *
    `,
    [
      record.id,
      nextStatus,
      resolvedAt,
      note,
      JSON.stringify(nowPayload),
      task ? task.id : null
    ]
  );

  return result.rows && result.rows[0] ? normalizeVerificationRecord(result.rows[0]) : null;
}

async function buildResolutionQueue(queryParams = {}) {
  const records = await getVerificationRecords(queryParams);
  const items = [];

  for (const record of records) {
    const task = await findRemediationTask(record);

    items.push({
      verification: record,
      record,
      remediationTask: task,
      remediation_task: task,
      taskStatus: task ? task.status : 'missing_task',
      task_status: task ? task.status : 'missing_task',
      terminal: task ? isTerminalTaskStatus(task.status) : false,
      resolutionStatus: record.remediation_resolution_status || 'open',
      resolution_status: record.remediation_resolution_status || 'open'
    });
  }

  return items;
}

router.get('/health', (_req, res) => {
  res.json({
    ok: true,
    route: 'tenant/closedLoopResolution',
    phase: '19.40-remediation-resolution-sync',
    purpose: 'Sync remediation task completion back to closed_loop_verifications',
    terminalTaskStatuses: ['done', 'resolved', 'completed', 'complete', 'closed', 'fixed'],
    endpoints: [
      'GET /api/tenant/closed-loop-resolution/queue',
      'POST /api/tenant/closed-loop-resolution/sync',
      'POST /api/tenant/closed-loop-resolution/:verificationId/resolve'
    ],
    timestamp: new Date().toISOString()
  });
});

router.get('/queue', async (req, res) => {
  try {
    const items = await buildResolutionQueue(req.query || {});

    return res.json({
      ok: true,
      data: {
        ok: true,
        phase: '19.40-remediation-resolution-sync',
        generatedAt: new Date().toISOString(),
        total: items.length,
        resolved: items.filter((item) => item.resolutionStatus === 'resolved').length,
        open: items.filter((item) => item.resolutionStatus === 'open').length,
        missingTask: items.filter((item) => item.taskStatus === 'missing_task').length,
        terminalReady: items.filter((item) => item.terminal).length,
        items,
        queue: items,
        rows: items,
        debug: {
          route: 'tenant/closedLoopResolution/queue',
          query: req.query || {}
        }
      }
    });
  } catch (error) {
    return res.status(500).json({
      ok: false,
      message: error.message || 'Closed loop resolution queue failed.',
      phase: '19.40-remediation-resolution-sync'
    });
  }
});

router.post('/sync', async (req, res) => {
  try {
    const queryParams = {
      ...(req.query || {}),
      ...(req.body || {})
    };

    const records = await getVerificationRecords(queryParams);
    const results = [];

    for (const record of records) {
      const task = await findRemediationTask(record);
      const updatedRecord = await updateResolutionFromTask(record, task, {
        mode: 'sync'
      });

      results.push({
        verificationId: record.id,
        verification_id: record.id,
        task: task || null,
        taskStatus: task ? task.status : 'missing_task',
        task_status: task ? task.status : 'missing_task',
        terminal: task ? isTerminalTaskStatus(task.status) : false,
        previousResolutionStatus: record.remediation_resolution_status || 'open',
        previous_resolution_status: record.remediation_resolution_status || 'open',
        resolutionStatus: updatedRecord ? updatedRecord.remediation_resolution_status : 'unknown',
        resolution_status: updatedRecord ? updatedRecord.remediation_resolution_status : 'unknown',
        updatedRecord,
        updated_record: updatedRecord
      });
    }

    return res.json({
      ok: true,
      data: {
        ok: true,
        phase: '19.40-remediation-resolution-sync',
        generatedAt: new Date().toISOString(),
        total: results.length,
        resolved: results.filter((item) => item.resolutionStatus === 'resolved').length,
        open: results.filter((item) => item.resolutionStatus === 'open').length,
        missingTask: results.filter((item) => item.taskStatus === 'missing_task').length,
        results,
        items: results,
        rows: results,
        debug: {
          route: 'tenant/closedLoopResolution/sync',
          query: req.query || {},
          body: req.body || {}
        }
      }
    });
  } catch (error) {
    return res.status(500).json({
      ok: false,
      message: error.message || 'Closed loop resolution sync failed.',
      phase: '19.40-remediation-resolution-sync'
    });
  }
});

router.post('/:verificationId/resolve', async (req, res) => {
  try {
    const verificationId = req.params.verificationId;

    const records = await getVerificationRecords({
      verificationId,
      limit: 1
    });

    const record = records[0];

    if (!record) {
      return res.status(404).json({
        ok: false,
        message: `Closed loop verification not found: ${verificationId}`,
        phase: '19.40-remediation-resolution-sync'
      });
    }

    const task = await findRemediationTask(record);

    const updatedRecord = await updateResolutionFromTask(record, task, {
      mode: 'manual_resolve',
      forceResolved: true,
      note: firstValue(
        req.body && req.body.note,
        'Manually marked as resolved from Closed Loop Resolution.'
      )
    });

    return res.json({
      ok: true,
      data: {
        ok: true,
        phase: '19.40-remediation-resolution-sync',
        generatedAt: new Date().toISOString(),
        verificationId,
        verification_id: verificationId,
        task,
        updatedRecord,
        updated_record: updatedRecord
      }
    });
  } catch (error) {
    return res.status(500).json({
      ok: false,
      message: error.message || 'Manual closed loop resolution failed.',
      phase: '19.40-remediation-resolution-sync'
    });
  }
});

module.exports = router;