# RAFTOP CPAP CARE Pro - Backend Production Environment Template
NODE_ENV=production
PORT=5001
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB_NAME?sslmode=require
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_PRODUCTION_SECRET_MIN_32_CHARS
CORS_ORIGIN=https://your-raftop-frontend-domain.com
SUBSCRIPTION_GUARD_ENABLED=true
PLAN_LIMIT_GUARD_ENABLED=true
PATIENT_ACCESS_GUARD_ENABLED=true
USER_ACTIVITY_AUDIT_ENABLED=true
SUBSCRIPTION_GUARD_BYPASS_KEY=
PLAN_LIMIT_GUARD_BYPASS_KEY=
PATIENT_ACCESS_GUARD_BYPASS_KEY=
ALLOW_DEV_PATIENT_LOGIN=false
SUPER_ADMIN_API_KEY=REPLACE_WITH_LONG_RANDOM_SUPER_ADMIN_KEY
RESTORE_BOOTSTRAP_KEY=REPLACE_WITH_LONG_RANDOM_RESTORE_KEY
